# ---------------------------------------------------------------------------
# Uma Fashions — environment variables
# Copy to .env for local development. Never commit real credentials.
# On Vercel, set these in each project's Environment Variables settings.
# ---------------------------------------------------------------------------

# PostgreSQL (Neon / Supabase). Use the POOLED connection string on serverless.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string (48+ bytes). Signs the httpOnly session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Public URLs used for cross-app links, canonical tags and sitemaps.
# Locally: website 3000, store 3001. In production use your real domains.
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_URL="http://localhost:3001"

# Initial owner account created by `npm run db:seed` (change after first login).
OWNER_EMAIL="owner@umafashions.in"
OWNER_PASSWORD="UmaDemo@2026"
STAFF_EMAIL="staff@umafashions.in"
STAFF_PASSWORD="StaffDemo@2026"

# Enquiries and new-order alerts are sent to OWNER_EMAIL above.

# --- Razorpay (optional for local development) -----------------------------
# Use TEST keys until the full flow passes. Never expose the secret in the browser.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-me"
RAZORPAY_WEBHOOK_SECRET="replace-me"

# --- Transactional email (optional) ---------------------------------------
# Resend HTTP API key. Without it emails are logged and skipped, never failed.
RESEND_API_KEY=""
EMAIL_FROM="Uma Fashions <onboarding@resend.dev>"
