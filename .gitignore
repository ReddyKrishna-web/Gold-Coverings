# =============================================================================
# FANCY STORE — Git ignore rules
# =============================================================================

# ─── Environment & Secrets (NEVER commit) ───────────────────────────────────
.env
.env.*
!.env.example
!.env.sample
.env.local
.env.development.local
.env.production.local

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ───────────────────────────────────────────────────────────
.next/
out/
build/
dist/

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Logs ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── Editor directories ──────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ─── Python/venv (if used) ──────────────────────────────────────────────────
venv/
.env.python
*.pyc
__pycache__/

# ─── Local data & temp ───────────────────────────────────────────────────────
.local/
*.pid
.cache/

# ─── Database local files ────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Misc ────────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz

# ─── Personal/OS directories (never commit user home contents) ───────────────
My Documents/
AppData/
Application Data/
Links/
Favorites/
Recent/
Searches/
Start Menu/
Cookies/
ntuser.*
ntuser.dat.*
Desktop.ini
